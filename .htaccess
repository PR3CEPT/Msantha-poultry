# Apache configuration for cPanel root
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent direct access to sensitive directories & files
    RewriteRule ^(\.env|\.git|app|config|storage|database|tests|cron)(/|$) - [F,L,NC]

    # Route all traffic to the public directory
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Block directory indexing
Options -Indexes

