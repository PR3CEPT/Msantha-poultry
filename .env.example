APP_NAME="Msantha Poultry Management System"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-render-domain.onrender.com
APP_TIMEZONE=Africa/Blantyre
APP_LOCALE=en

DB_CONNECTION=mysql
DB_HOST=your-db-host
DB_PORT=3306
DB_DATABASE=msantha_poultry
DB_USERNAME=your-db-user
DB_PASSWORD=your-db-password
DB_CHARSET=utf8mb4

PAYCHANGU_SECRET_KEY=your-paychangu-secret-key
PAYCHANGU_WEBHOOK_SECRET=your-paychangu-webhook-secret
PAYCHANGU_RETURN_URL=https://your-render-domain.onrender.com/payments/callback
PAYCHANGU_CALLBACK_URL=https://your-render-domain.onrender.com/webhooks/paychangu
PAYCHANGU_MODE=live

SMS_PROVIDER=africas_talking
SMS_SENDER_ID=MSANTHA
SMS_USERNAME=your-at-username
SMS_API_KEY=your-at-api-key

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-gmail@gmail.com
MAIL_PASSWORD="your-gmail-app-password"
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=your-gmail@gmail.com
MAIL_FROM_NAME="Msantha Investments and General Suppliers (MIGS)"
